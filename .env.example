# ─────────────────────────────────────────────────────────────
# LEXGUARD — Environment variables (example)
# Copy to .env.local and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Google AI / Gemini (free tier — AI Studio) ──
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional extra keys — rotated on 429 so you can squeeze more out of free tier
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash-lite

# ── Groq fallback (used when Gemini quota is exhausted) ──
# Get a key at https://console.groq.com/keys — 14,400 RPD on free tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── Google Cloud / Vertex AI (production only — leave blank locally) ──
# When deployed to Cloud Run, these flip the AI chain to Vertex AI (no API
# key, uses the runtime service account's ADC credentials). Locally, leaving
# USE_VERTEX_AI unset means we keep using the AI Studio key path.
USE_VERTEX_AI=
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1

# ── Secret Manager refs (Cloud Run only) ──
# When set AND running on Cloud Run (K_SERVICE is auto-injected), the API
# resolves these at boot and injects the value into the matching env var.
# Format: bare name ("gemini-api-key") OR full resource name.
GEMINI_API_KEY_SECRET=
GROQ_API_KEY_SECRET=

# ── App ──
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
